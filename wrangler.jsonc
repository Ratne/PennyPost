{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "penny-post",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 30000 },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newsletter",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],

  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "newsletter-images" }],

  "queues": {
    "producers": [
      { "binding": "SEND_QUEUE", "queue": "newsletter-send" },
      { "binding": "EVENTS_QUEUE", "queue": "newsletter-events" }
    ],
    "consumers": [
      {
        "queue": "newsletter-send",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 10,
        "dead_letter_queue": "newsletter-send-dlq"
      },
      {
        "queue": "newsletter-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "newsletter-events-dlq"
      }
    ]
  },

  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],

  "triggers": { "crons": ["* * * * *"] },

  "vars": {
    "APP_URL": "http://localhost:5173",
    "SENDING_ENABLED": "false",
    "SES_REGION": "us-east-1",
    "SEND_RATE_PER_SECOND": "10",
    "IMAGES_PUBLIC_URL": ""
  }
  // Secrets (wrangler secret put): SESSION_SECRET, SES_ACCESS_KEY_ID, SES_SECRET_ACCESS_KEY,
  // SES_SNS_TOPIC_ARN, and optionally ARCHIVE_HOSTS, EMAILABLE_API_KEY. ADMIN_EMAIL and
  // ADMIN_PASSWORD only seed the first admin. SENDING_ENABLED, SES_REGION, SES_CONFIGURATION_SET,
  // SEND_RATE_PER_SECOND and ALERT_FROM can be overridden in Settings. Locally: .dev.vars
}
